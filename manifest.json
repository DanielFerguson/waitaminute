{
  "manifest_version": 3,
  "name": "WaitAMinute",
  "version": "1.2.0",
  "description": "Add intentional friction before accessing distracting websites",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_page": "popup/popup.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/rules.js", "content/content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "web_accessible_resources": [{
    "resources": ["block/block.html"],
    "matches": ["<all_urls>"]
  }]
}
